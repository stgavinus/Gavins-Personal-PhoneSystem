[Unit]
Description=VoiceProject AI Server (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/VoiceProject/ai-server
EnvironmentFile=/home/ubuntu/VoiceProject/.env
ExecStart=/home/ubuntu/VoiceProject/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-server

[Install]
WantedBy=multi-user.target
