[global]
type=global
endpoint_identifier_order=username,ip,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=YOUR_VPS_PUBLIC_IP
external_media_address=YOUR_VPS_PUBLIC_IP
local_net=YOUR_LOCAL_NET/24

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_signaling_address=YOUR_VPS_PUBLIC_IP
external_media_address=YOUR_VPS_PUBLIC_IP
local_net=YOUR_LOCAL_NET/24

; ── Extension 100 — Mac ──────────────────────────────────────────
[100]
type=endpoint
context=from-internal
disallow=all
allow=ulaw
allow=alaw
allow=slin
allow=slin16
auth=100
aors=100
callerid=Mac <100>
direct_media=no
media_address=YOUR_VPS_PUBLIC_IP
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
ice_support=no

[100]
type=auth
auth_type=userpass
username=100
password=CHANGE_ME

[100]
type=aor
max_contacts=1
remove_existing=yes

; ── Extension 101 — iPhone ───────────────────────────────────────
[101]
type=endpoint
context=from-internal
disallow=all
allow=ulaw
allow=alaw
allow=slin
allow=slin16
auth=101
aors=101
callerid=iPhone <101>
direct_media=no
media_address=YOUR_VPS_PUBLIC_IP
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
ice_support=no

[101]
type=auth
auth_type=userpass
username=101
password=CHANGE_ME

[101]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30
default_expiration=120
minimum_expiration=60
maximum_expiration=120
